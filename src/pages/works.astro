---
import Layout from "../layouts/Layout.astro";
import "../../css/blocks.css";
const metadata = {
  title: "作品",
  description:
    "夹夹 MCP 服务端、Agent Harness 与 mini-swe，记录知识库接入、Agent 任务执行和编码代理模型路由的工程实践。",
  alternates: { canonical: "/works" },
};
const projects = [
  {
    id: "jiajia-mcp",
    name: "夹夹 MCP 服务端",
    category: "MCP · 团队项目",
    tone: "paper",
    summary:
      "把经过审核和脱敏的 QQ 群知识库接入 AI Agent，让 Agent 能检索问答、讨论、面经和日报周报。",
    detail:
      "我负责服务端实现与联调。工具沿用网站的内容读取和权限规则，服务端核验账号身份、对返回内容做安全处理，并按账号限额、记录用量。",
    tags: ["MCP", "OAuth", "Cloudflare Workers", "D1"],
    links: [
      { href: "https://jiajia.fun/mcp", label: "看接入指南" },
      {
        href: "https://github.com/Joye-Co/jiajia-mcp/blob/main/docs/mcp.md",
        label: "查看公开契约",
      },
    ],
  },
  {
    name: "Agent Harness",
    category: "Agent 工程",
    tone: "navy",
    summary:
      "围绕 Agent 任务执行搭建的工程实验项目，探索工具调用、Skill、上下文管理与执行预算。",
    detail:
      "使用 LangGraph 管理执行循环，记录任务运行与产物，并实践检查点、审批暂停和跨进程恢复。",
    tags: ["TypeScript", "Python", "LangGraph", "Agent"],
    links: [
      {
        href: "https://github.com/ashyh123/agent-harness",
        label: "查看 Agent Harness 源码",
      },
    ],
  },
  {
    name: "mini-swe",
    category: "编码 Agent",
    tone: "sage",
    summary:
      "一个带模型路由的轻量编码代理：先判断任务难度，再选择模型完成读代码、修改、测试与提交。",
    detail:
      "将路由放在代理循环外，保持单次任务的模型选择稳定；通过任务评测对比 cheap、strong 与 router 模式的成功率和成本。",
    tags: ["Python", "模型路由", "工具调用", "评测"],
  },
];
---

<Layout
  title={metadata.title}
  description={metadata.description}
  canonical={metadata.alternates?.canonical}
>
  <div class="block-page">
    <header class="block-hero block-surface">
      <h1>把想法做出来</h1>
      <p>从小项目开始，理解代码怎样变成一个可以使用的东西。</p>
    </header>
    <div class="projects-grid">
      {projects.map((project) => (
        <article
          id={project.id}
          class="project-block block-surface"
          data-tone={project.tone}
        >
          <p class="project-category">{project.category}</p>
          <h2>{project.name}</h2>
          <p class="project-summary">{project.summary}</p>
          <p class="project-detail">{project.detail}</p>
          <ul aria-label={`${project.name} 技术与方向`} class="block-tags">
            {project.tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
          {project.links && (
            <div class="project-links">
              {project.links.map(({ href, label }) => {
                const external = href.startsWith("https://");
                return (
                  <a
                    href={href}
                    target={external ? "_blank" : undefined}
                    rel={external ? "noopener noreferrer" : undefined}
                  >
                    {label}{" "}
                    <span aria-hidden="true">{external ? "↗" : "→"}</span>
                  </a>
                );
              })}
            </div>
          )}
        </article>
      ))}
    </div>
    <p class="works-footnote">更多项目，随着学习慢慢积累。</p>
  </div>
</Layout>
<style>
  .projects-grid {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: 20px;
  }
  .project-block {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-height: 420px;
    padding: 34px;
  }
  .project-block:first-child {
    grid-column: 1 / -1;
    min-height: 0;
  }
  .project-category {
    font-size: 13px;
    margin-bottom: 18px;
  }
  .project-block h2 {
    font-size: 30px;
    line-height: 1.4;
  }
  .project-summary {
    margin-top: 20px;
  }
  .project-detail {
    margin-top: 13px;
  }
  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 24px;
    margin-top: auto;
    padding-top: 24px;
    font-size: 14px;
  }
  .project-links span {
    margin-left: 4px;
  }
  @media (max-width: 800px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
    .project-block {
      min-height: 0;
    }
  }
  @media (max-width: 700px) {
    .project-block {
      padding: 25px;
    }
    .project-block h2 {
      font-size: 27px;
    }
  }
</style>
