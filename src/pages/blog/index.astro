---
import Layout from "../../layouts/Layout.astro";
import "../../../css/blocks.css";
import BlogIndex from "../../components/BlogIndex.astro";
import { getPosts } from "../../../lib/content.mjs";
const metadata = {
  title: "学习记录",
  description: "从零学习 Agent 的记录、踩坑与项目实践。",
  alternates: { canonical: "/blog" },
};

const posts = getPosts().map(({ body, ...post }) => post);
---

<Layout
  title={metadata.title}
  description={metadata.description}
  canonical={metadata.alternates?.canonical}
>
  <div class="block-page">
    <header class="block-hero block-surface">
      <h1>学习记录</h1>
      <p>把做过的事、遇到的问题和想明白的瞬间，留在这里。</p>
    </header>
    <BlogIndex
      posts={posts}
      tags={[...new Set(posts.flatMap((post) => post.tags))].sort()}
    />
  </div>
</Layout>
