---
import Layout from "../../layouts/Layout.astro";
import {
  getPosts,
  getPost,
  getSeries,
  renderMarkdown,
} from "../../../lib/content.mjs";
import { formatDate } from "../../../lib/date.mjs";
import PageHeading from "../../components/PageHeading.astro";
import EmptyState from "../../components/EmptyState.astro";
import { rssEnabled, site } from "../../../data/site.js";
export function getStaticPaths() {
  return getPosts().map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}
const { post } = Astro.props;
const { html, headings } = await renderMarkdown(post.body);
const series = getSeries().find((item) => item.slug === post.series);
const index = series?.posts.findIndex((item) => item.slug === post.slug);
const previous = series?.posts[index - 1];
const next = series?.posts[index + 1];
const related = getPosts()
  .filter(
    (item) =>
      item.slug !== post.slug &&
      item.tags.some((tag) => post.tags.includes(tag)),
  )
  .slice(0, 3);
---

<Layout
  title={post.title}
  description={post.summary}
  canonical={`/blog/${Astro.params.slug}`}
  article={post}
>
  <>
    <a class="back-link" href="/blog">
      返回学习记录
    </a>
    <header class="article-heading">
      <div class="post-meta">
        <time datetime={post.date}>{formatDate(post.date)}</time>
        <span>{post.readingMinutes} 分钟阅读</span>
        {post.updated && <span>更新于 {formatDate(post.updated)}</span>}
      </div>
      <h1>{post.title}</h1>
      <p>{post.summary}</p>
      <div class="tag-list">
        {post.tags.map((tag) => (
          <span class="tag">{tag}</span>
        ))}
      </div>
      {series && (
        <a class="series-label" href={`/series/${series.slug}`}>
          {series.title} / 第 {index + 1} 篇
        </a>
      )}
    </header>
    <div class="reading-layout article-layout">
      <article>
        <div class="prose" data-reading-body set:html={html} />
        <div class="article-contact">
          <h2>一起交流</h2>
          <p>你也遇到过类似的问题吗？欢迎分享你的实践。</p>
          <div class="contact-links">
            <a href={site.github}>GitHub</a>
            <a href={`mailto:${site.email}`}>邮箱联系</a>
            <a href={site.x} target="_blank" rel="noopener noreferrer">
              X
            </a>
            {rssEnabled && <a href="/rss.xml">RSS 订阅</a>}
          </div>
        </div>
        {series && (
          <nav aria-label="系列文章导航" class="article-pagination">
            {previous ? (
              <a href={`/blog/${previous.slug}`}>
                <span>上一篇</span>
                {previous.title}
              </a>
            ) : (
              <span />
            )}
            {next && (
              <a href={`/blog/${next.slug}`}>
                <span>下一篇</span>
                {next.title}
              </a>
            )}
          </nav>
        )}
        {related.length > 0 && (
          <section class="related-posts">
            <h2>继续阅读</h2>
            {related.map((item) => (
              <a href={`/blog/${item.slug}`}>{item.title}</a>
            ))}
          </section>
        )}
      </article>
      <aside class="sidebar toc">
        <details open>
          <summary>文章目录</summary>
          {headings.length ? (
            <nav aria-label="文章目录">
              {headings.map((heading) => (
                <a
                  class={heading.depth === 3 ? "toc-nested" : ""}
                  href={`#${heading.id}`}
                >
                  {heading.title}
                </a>
              ))}
            </nav>
          ) : (
            <p>这篇文章没有分节标题。</p>
          )}
        </details>
      </aside>
    </div>
    <div
      class="reading-progress"
      data-reading-progress
      role="progressbar"
      aria-label="文章阅读进度"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="0"
      hidden
    >
      <svg
        class="reading-progress-outline"
        viewBox="0 0 56 56"
        aria-hidden="true"
      >
        <path d="M28 3H41a12 12 0 0 1 12 12v26a12 12 0 0 1-12 12H15A12 12 0 0 1 3 41V15A12 12 0 0 1 15 3Z" />
        <path
          class="reading-progress-trace"
          pathLength="100"
          d="M28 3H41a12 12 0 0 1 12 12v26a12 12 0 0 1-12 12H15A12 12 0 0 1 3 41V15A12 12 0 0 1 15 3Z"
        />
      </svg>
      <span class="reading-progress-readout" aria-hidden="true">
        <span class="reading-progress-value" data-reading-value>
          0
        </span>
        <span class="reading-progress-unit">%</span>
      </span>
    </div>
  </>
</Layout>

<script>
  import { onPageChange } from "../../scripts/page-lifecycle";
  onPageChange((signal) => {
    document
      .querySelectorAll<HTMLAnchorElement>('.prose p > a[href^="/diagrams/"]')
      .forEach((link) => {
        const image = link.querySelector("img");
        const paragraph = link.parentElement;
        const source = link.getAttribute("href");
        if (
          !image ||
          !paragraph ||
          paragraph.childElementCount !== 1 ||
          paragraph.textContent?.trim() ||
          !source ||
          !/^\/diagrams\/[a-z0-9-]+\.html$/.test(source)
        )
          return;
        const frame = document.createElement("iframe");
        frame.src = source;
        frame.title = image.alt;
        frame.loading = "lazy";
        const figure = document.createElement("figure");
        figure.className = "interactive-diagram";
        const caption = document.createElement("figcaption");
        caption.textContent =
          "点击图中步骤查看说明；用下方按钮缩放，放大后可在图内滚动查看。";
        figure.append(frame, caption);
        paragraph.replaceWith(figure);
      });
    document
      .querySelectorAll<HTMLElement>(".process-diagram")
      .forEach((figure, index) => {
        if (figure.dataset.enhanced) return;
        const steps = Array.from(
          figure.querySelectorAll<HTMLElement>("ol > li"),
        );
        const panel = document.createElement("div");
        panel.className = "process-detail";
        panel.id = `process-detail-${index}`;
        panel.setAttribute("aria-live", "polite");
        const controls: HTMLButtonElement[] = [];
        const select = (selected: number) => {
          controls.forEach((button, item) =>
            button.setAttribute("aria-pressed", String(item === selected)),
          );
          steps.forEach((step, item) =>
            step.classList.toggle("is-current", item === selected),
          );
          panel.replaceChildren(
            ...Array.from(steps[selected].children)
              .slice(2)
              .map((child) => child.cloneNode(true)),
          );
        };
        steps.forEach((step, item) => {
          const title = step.querySelector("strong");
          if (!title) return;
          const button = document.createElement("button");
          button.type = "button";
          button.className = "specular-button";
          button.textContent = title.textContent;
          button.setAttribute("aria-controls", panel.id);
          button.addEventListener("click", () => select(item), { signal });
          controls.push(button);
          title.replaceWith(button);
        });
        figure.dataset.enhanced = "true";
        figure.append(panel);
        select(0);
      });

    const body = document.querySelector<HTMLElement>("[data-reading-body]");
    const progress = document.querySelector<HTMLElement>(
      "[data-reading-progress]",
    );
    const value = progress?.querySelector<HTMLElement>("[data-reading-value]");
    if (body && progress && value) {
      let frame = 0;
      const update = () => {
        frame = 0;
        const bounds = body.getBoundingClientRect();
        const distance = bounds.height - window.innerHeight;
        const ratio =
          distance > 0
            ? Math.max(0, Math.min(1, -bounds.top / distance))
            : Number(bounds.bottom <= window.innerHeight);
        const percent = Math.round(ratio * 100);
        value.textContent = String(percent);
        progress.setAttribute("aria-valuenow", String(percent));
        progress.style.setProperty("--reading-progress", String(ratio));
        progress.hidden = false;
      };
      const schedule = () => {
        if (!frame) frame = requestAnimationFrame(update);
      };
      const observer = new ResizeObserver(schedule);
      observer.observe(body);
      window.addEventListener("scroll", schedule, { passive: true, signal });
      window.addEventListener("resize", schedule, { signal });
      signal.addEventListener(
        "abort",
        () => {
          observer.disconnect();
          cancelAnimationFrame(frame);
        },
        { once: true },
      );
      update();
    }
  });
</script>

<style is:global>
  .reading-progress {
    position: fixed;
    right: 24px;
    bottom: calc(24px + env(safe-area-inset-bottom, 0px));
    z-index: 90;
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 16px;
    background: transparent;
    color: var(--ink);
    pointer-events: none;
    user-select: none;
  }
  .reading-progress-outline {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: var(--line);
    stroke-width: 1;
  }
  .reading-progress-trace {
    stroke: var(--accent-dark);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-dasharray: 100;
    stroke-dashoffset: calc(100 - var(--reading-progress, 0) * 100);
  }
  .reading-progress-readout {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: 1px;
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }
  .reading-progress-value {
    font-size: 16px;
    font-weight: 500;
    letter-spacing: -0.03em;
  }
  .reading-progress-unit {
    color: var(--muted);
    font-size: 10px;
  }
  .prose .interactive-diagram {
    margin: 28px 0;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 8px;
  }
  .interactive-diagram iframe {
    display: block;
    width: 100%;
    height: 660px;
    border: 0;
    background: #f5f7f3;
  }
  .interactive-diagram figcaption {
    padding: 12px 15px;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.7;
  }
  @media (max-width: 700px) {
    .reading-progress {
      right: 14px;
      bottom: calc(14px + env(safe-area-inset-bottom, 0px));
      width: 50px;
      height: 50px;
      border-radius: 14px;
    }
    .reading-progress-value {
      font-size: 15px;
    }
    .interactive-diagram iframe {
      height: 460px;
    }
  }
</style>
