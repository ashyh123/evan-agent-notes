---
import { friendLinks, site, siteUrl } from "../../data/site.js";
import FriendGalaxy from "../components/friends/FriendGalaxy.jsx";
import Layout from "../layouts/Layout.astro";

const owner = { name: site.author, url: "/", avatar: "/images/avatar.png" };
const stars = [owner, ...friendLinks];
const exchangeCard = [
  `Name: ${site.name}`,
  `Desc: ${site.description}`,
  `Link: ${new URL(owner.url, siteUrl).href}`,
  `Avatar: ${new URL(owner.avatar, siteUrl).href}`,
].join("\n");
const applicationBody = ["Name: ", "Desc: ", "Link: ", "Avatar: "].join("\r\n");
const applicationUrl = `mailto:${site.email}?subject=${encodeURIComponent("交换友链")}&body=${encodeURIComponent(applicationBody)}`;
---

<Layout
  title="友链"
  description="在星空里遇见 Evan 的博客朋友。"
  canonical="/friends"
>
  <friend-constellation
    class="friend-sky"
    data-friend-sky
    aria-labelledby="friends-title"
  >
    <FriendGalaxy client:load />

    <header class="friend-heading">
      <h1 id="friends-title">友链</h1>
      <p>{site.name}</p>
    </header>

    <svg class="friend-connections" aria-hidden="true">
      {friendLinks.map(() => (
        <path />
      ))}
    </svg>

    <ul class="friend-stars">
      {stars.map((star, index) => (
        <li>
          <a
            class="friend-star"
            href={star.url}
            target={index === 0 ? undefined : "_blank"}
            rel={index === 0 ? undefined : "noopener noreferrer"}
          >
            <img
              src={star.avatar}
              alt=""
              width="43"
              height="43"
              draggable="false"
            />
            <span>
              {star.name}
              {index > 0 && <span aria-hidden="true"> ↗</span>}
              {star.description && <small>{star.description}</small>}
            </span>
          </a>
        </li>
      ))}
    </ul>
  </friend-constellation>

  <details class="friend-exchange">
    <summary>交换友链</summary>
    <p>下面是本站资料。申请时，请按同样的四行格式填写你的博客信息。</p>
    <pre id="friend-exchange-card">{exchangeCard}</pre>
    <div class="friend-exchange-actions">
      <button type="button" id="copy-friend-exchange-card" hidden>
        复制本站资料
      </button>
      <a href={applicationUrl}>邮件申请友链 <span aria-hidden="true">↗</span></a>
    </div>
    <div id="friend-copy-status" role="status"></div>
  </details>
</Layout>

<script>
  class FriendConstellation extends HTMLElement {
    #resize;

    connectedCallback() {
      const portraits = [...this.querySelectorAll(".friend-star img")];
      const [owner, ...friends] = portraits;
      const paths = this.querySelectorAll(".friend-connections path");
      if (!owner || friends.length === 0) return;

      const drawConnections = () => {
        const scene = this.getBoundingClientRect();
        const center = (portrait: Element) => {
          const bounds = portrait.getBoundingClientRect();
          return {
            x: bounds.left - scene.left + bounds.width / 2,
            y: bounds.top - scene.top + bounds.height / 2,
          };
        };
        const start = center(owner);
        friends.forEach((portrait, index) => {
          const end = center(portrait);
          const middle = (start.x + end.x) / 2;
          paths[index]?.setAttribute(
            "d",
            `M ${start.x} ${start.y} Q ${middle} ${start.y} ${end.x} ${end.y}`,
          );
        });
      };
      this.#resize = new ResizeObserver(drawConnections);
      this.#resize.observe(this);
      drawConnections();
    }

    disconnectedCallback() {
      this.#resize?.disconnect();
    }
  }

  customElements.define("friend-constellation", FriendConstellation);

  const copyButton = document.querySelector<HTMLButtonElement>(
    "#copy-friend-exchange-card",
  );
  const cardText = document
    .querySelector("#friend-exchange-card")
    ?.textContent?.trim();
  const copyStatus = document.querySelector("#friend-copy-status");
  if (copyButton && cardText && copyStatus && navigator.clipboard) {
    copyButton.hidden = false;
    copyButton.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(cardText);
        copyStatus.textContent = "已复制本站资料。";
      } catch {
        copyStatus.textContent = "请选中上方资料手动复制。";
      }
    });
  }
</script>

<style>
  .friend-sky {
    --sky-ink: #edf2fb;
    --sky-muted: #abbcd2;
    --sky-thread: #90aacc;
    --sky-focus: #c6defe;
    --sky-avatar-core: #9bb7e985;
    --sky-avatar-halo: #9bb7e962;
    --sky-avatar-hover: #a9c3e5a0;
    display: grid;
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: clamp(350px, 52vw, 485px);
    border-radius: 24px;
    background:
      radial-gradient(ellipse at 36% 96%, #162743 0%, transparent 64%), #080d17;
    color: var(--sky-ink);
    touch-action: manipulation;
  }

  :global(:root[data-theme="light"]) .friend-sky {
    --sky-ink: #233a57;
    --sky-muted: #435c7c;
    --sky-thread: #456b98;
    --sky-focus: #355f96;
    --sky-avatar-core: #7295bd66;
    --sky-avatar-halo: #8faedb82;
    --sky-avatar-hover: #7e9fcaa3;
    background:
      radial-gradient(ellipse at 80% 5%, #f9fcff 0%, transparent 62%),
      radial-gradient(ellipse at 24% 105%, #c5d9f2 0%, transparent 65%), #eaf1fb;
  }

  .friend-sky :global(.friend-galaxy),
  .friend-connections {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .friend-heading {
    position: absolute;
    top: clamp(24px, 4.3vw, 41px);
    left: clamp(23px, 5.1vw, 48px);
    pointer-events: none;
  }

  .friend-heading h1 {
    font-size: clamp(25px, 3.4vw, 34px);
    font-weight: 500;
    letter-spacing: 0.055em;
    line-height: 1.35;
  }

  .friend-heading p {
    margin-top: 7px;
    color: var(--sky-muted);
    font-size: 13px;
  }

  .friend-connections path {
    fill: none;
    stroke: var(--sky-thread);
    stroke-opacity: 0.2;
    transition: stroke-opacity 250ms ease;
  }

  .friend-sky:has(.friend-star:is(:hover, :focus-visible))
    .friend-connections
    path {
    stroke-opacity: 0.45;
  }

  .friend-stars {
    position: relative;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(112px, 50%), 1fr));
    align-content: center;
    justify-items: center;
    gap: 48px 0;
    margin: 0;
    padding: 104px 10% 56px;
    list-style: none;
    pointer-events: none;
  }

  .friend-stars li {
    min-width: 0;
    max-width: 100%;
  }

  .friend-stars li:nth-child(odd) {
    transform: translateY(24px);
  }

  .friend-stars li:nth-child(even) {
    transform: translateY(-24px);
  }

  .friend-star {
    --portrait: clamp(28px, 4.5vw, 40px);
    display: flex;
    min-width: 48px;
    min-height: 44px;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding-inline: 4px;
    color: var(--sky-muted);
    font-size: 12px;
    text-align: center;
    overflow-wrap: anywhere;
    pointer-events: auto;
  }

  .friend-stars li:first-child .friend-star {
    --portrait: clamp(30px, 4.85vw, 43px);
  }

  .friend-star small {
    display: block;
    margin-top: 4px;
    font-size: 11px;
  }

  .friend-star img {
    display: block;
    width: var(--portrait);
    height: var(--portrait);
    border-radius: 50%;
    object-fit: cover;
    box-shadow:
      0 0 8px var(--sky-avatar-core),
      0 0 24px var(--sky-avatar-halo);
    transition:
      transform 250ms ease,
      box-shadow 250ms ease;
  }

  .friend-star:is(:hover, :focus-visible) {
    color: var(--sky-ink);
  }

  .friend-star:is(:hover, :focus-visible) img {
    transform: scale(1.1);
    box-shadow: 0 0 30px var(--sky-avatar-hover);
  }

  .friend-star:focus-visible {
    outline-color: var(--sky-focus);
  }

  .friend-exchange {
    margin-top: 13px;
    padding-inline: 3px;
    color: var(--muted);
    font-size: 13px;
  }

  .friend-exchange summary {
    width: fit-content;
    min-height: 44px;
    line-height: 44px;
    cursor: pointer;
  }

  .friend-exchange p {
    margin-block: 3px 7px;
  }

  .friend-exchange pre {
    padding: 12px 14px;
    border: 1px solid var(--line);
    border-radius: 10px;
    color: var(--ink);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .friend-exchange-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 16px;
  }

  .friend-exchange-actions a,
  .friend-exchange-actions button {
    line-height: 44px;
    color: var(--accent-dark);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .friend-exchange-actions button {
    cursor: pointer;
  }

  @media (prefers-reduced-motion: reduce) {
    .friend-connections path,
    .friend-star img {
      transition: none;
    }

    .friend-star:is(:hover, :focus-visible) img {
      transform: none;
    }
  }
</style>
