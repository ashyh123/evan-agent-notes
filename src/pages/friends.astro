---
import { friendLinks, site, siteUrl } from "../../data/site.js";
import { originalHost, pagesOrigin } from "../../data/friend-links.js";
import FriendGalaxy from "../components/friends/FriendGalaxy.jsx";
import Shuffle from "../components/friends/Shuffle.jsx";
import Layout from "../layouts/Layout.astro";

const friendHeading = "Visit My Friends Among the Stars";
const owner = { name: site.author, url: "/", avatar: "/images/avatar.png" };
const stars = [owner, ...friendLinks];
const exchangeFields = [
  ["站点名称", site.name],
  ["站点简介", site.description],
  ["站点网址", new URL(owner.url, siteUrl).href],
  ["头像网址", new URL(owner.avatar, siteUrl).href],
];
const exchangeCard = exchangeFields
  .map(([label, value]) => `${label}：${value}`)
  .join("\n");
const applicationApi =
  new URL(siteUrl).hostname === originalHost
    ? `${pagesOrigin}/api/friends`
    : "/api/friends";
---

<Layout
  title="友链"
  description="在星空里遇见 Evan 的博客朋友。"
  canonical="/friends"
>
  <div slot="background" class="friend-backdrop" aria-hidden="true">
    <FriendGalaxy client:load />
  </div>

  <friend-constellation
    class="friend-sky"
    data-friend-sky
    data-friends-api={applicationApi}
    aria-labelledby="friends-title"
  >
    <header class="friend-heading">
      <h1 id="friends-title" lang="en" aria-label={friendHeading}>
        <Shuffle client:load tag="span" text={friendHeading} />
      </h1>
      <p lang="en">Pick a star and drop by a friend’s blog.</p>
    </header>

    <svg class="friend-connections" aria-hidden="true">
      {friendLinks.map(() => (
        <path />
      ))}
    </svg>

    <ul class="friend-stars">
      {stars.map((star, index) => (
        <li class="friend-star-position">
          <a
            class="friend-star"
            href={star.url}
            target={index === 0 ? undefined : "_blank"}
            rel={index === 0 ? undefined : "noopener noreferrer"}
          >
            <img
              src={star.avatar}
              alt=""
              width="43"
              height="43"
              draggable="false"
            />
            <span>
              {star.name}
              {index > 0 && <span aria-hidden="true"> ↗</span>}
              {star.description && <small>{star.description}</small>}
            </span>
          </a>
        </li>
      ))}
      <li class="friend-invite-position">
        <button
          class="friend-invite"
          type="button"
          aria-controls="friend-exchange"
          aria-expanded="false"
          hidden
        >
          <span class="friend-invite-mark" aria-hidden="true">
            <svg
              viewBox="0 0 20 20"
              width="17"
              height="17"
              fill="none"
              stroke="currentColor"
              stroke-width="1.35"
              stroke-linecap="round"
            >
              <path d="M10 3.5v13M3.5 10h13" />
            </svg>
          </span>
          <span>点亮你的星</span>
          <small>交换友链</small>
        </button>
      </li>
    </ul>
    <template data-approved-friend>
      <li class="friend-star-position">
        <a class="friend-star" target="_blank" rel="noopener noreferrer">
          <img
            alt=""
            width="43"
            height="43"
            draggable="false"
            referrerpolicy="no-referrer"
          />
          <span>
            <span data-friend-name></span>
            <span aria-hidden="true"> ↗</span>
            <small></small>
          </span>
        </a>
      </li>
    </template>
  </friend-constellation>

  <details class="friend-exchange" id="friend-exchange">
    <summary>给你的博客留个位置</summary>
    <p>提交后会先检查互链，审核通过后，你的头像就会出现在这片星空里。</p>
    <ol class="friend-exchange-steps">
      <li>
        <h2>1. 先把本站加到你的友链页</h2>
        <pre id="friend-exchange-card">{exchangeCard}</pre>
        <div class="friend-exchange-actions">
          <button
            type="button"
            data-copy-friend-exchange="friend-exchange-card"
            hidden
          >
            复制本站资料
          </button>
          <span role="status"></span>
        </div>
      </li>
      <li>
        <h2>2. 介绍你的小站</h2>
        <form class="friend-application" method="post">
          <label>
            站点名称 <input name="name" maxlength="60" required />
          </label>
          <label>
            站点简介{" "}
            <textarea
              name="description"
              rows="2"
              maxlength="180"
              required
            ></textarea>
          </label>
          <label>
            站点网址{" "}
            <input
              name="url"
              type="url"
              maxlength="500"
              placeholder="https://"
              required
            />
          </label>
          <label>
            头像网址{" "}
            <input
              name="avatar"
              type="url"
              maxlength="500"
              placeholder="https://"
              required
            />
          </label>
          <label>
            已添加本站的页面地址{" "}
            <input
              name="backlink"
              type="url"
              maxlength="500"
              placeholder="https://"
              required
            />
          </label>
          <button type="submit" disabled>
            检查互链并提交
          </button>
          <span role="status"></span>
        </form>
      </li>
    </ol>
  </details>
</Layout>

<script>
  import { onPageChange } from "../scripts/page-lifecycle";

  class FriendConstellation extends HTMLElement {
    #resize;

    connectedCallback() {
      this.#resize = new ResizeObserver(() => this.drawConnections());
      this.#resize.observe(this);
      this.drawConnections();
    }

    drawConnections() {
      const portraits = [...this.querySelectorAll(".friend-star img")];
      const [owner, ...friends] = portraits;
      const lines = this.querySelector(".friend-connections");
      if (!owner || !lines) return;
      const paths = lines.querySelectorAll("path");
      const scene = this.getBoundingClientRect();
      const center = (portrait: Element) => {
        const bounds = portrait.getBoundingClientRect();
        return {
          x: bounds.left - scene.left + bounds.width / 2,
          y: bounds.top - scene.top + bounds.height / 2,
        };
      };
      const start = center(owner);
      friends.forEach((portrait, index) => {
        const end = center(portrait);
        const middle = (start.x + end.x) / 2;
        const path =
          paths[index] ??
          lines.appendChild(
            document.createElementNS("http://www.w3.org/2000/svg", "path"),
          );
        path.setAttribute(
          "d",
          `M ${start.x} ${start.y} Q ${middle} ${start.y} ${end.x} ${end.y}`,
        );
      });
    }

    appendFriends(
      friends: {
        name: string;
        description: string;
        url: string;
        avatar: string;
      }[],
    ) {
      const template = this.querySelector<HTMLTemplateElement>(
        "[data-approved-friend]",
      );
      const invite = this.querySelector(".friend-invite-position");
      if (!template || !invite) return;
      for (const friend of friends) {
        const row = template.content.cloneNode(true) as DocumentFragment;
        row.querySelector("a")!.href = friend.url;
        row.querySelector("img")!.src = friend.avatar;
        row.querySelector("[data-friend-name]")!.textContent = friend.name;
        row.querySelector("small")!.textContent = friend.description;
        invite.before(row);
      }
      this.drawConnections();
    }

    disconnectedCallback() {
      this.#resize?.disconnect();
    }
  }

  customElements.define("friend-constellation", FriendConstellation);

  onPageChange((signal) => {
    const constellation = document.querySelector<FriendConstellation>(
      "friend-constellation",
    );
    const form = document.querySelector<HTMLFormElement>(".friend-application");
    const endpoint = constellation?.dataset.friendsApi;
    const submit = form?.querySelector<HTMLButtonElement>(
      'button[type="submit"]',
    );
    const applicationStatus = form?.querySelector('[role="status"]');
    if (constellation && form && endpoint && submit && applicationStatus) {
      fetch(endpoint, { signal })
        .then((response) => (response.ok ? response.json() : null))
        .then((result) => {
          if (result && !signal.aborted)
            constellation.appendFriends(result.friends);
        })
        .catch(() => {});
      submit.disabled = false;
      form.addEventListener(
        "submit",
        async (event) => {
          event.preventDefault();
          if (submit.disabled) return;
          submit.disabled = true;
          applicationStatus.textContent = "正在检查互链页面…";
          try {
            const response = await fetch(endpoint, {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify(Object.fromEntries(new FormData(form))),
              signal,
            });
            const result = await response.json();
            if (response.ok) form.reset();
            applicationStatus.textContent = result.message ?? result.error;
          } catch {
            if (!signal.aborted)
              applicationStatus.textContent = "暂时提交不了，请稍后再试。";
          } finally {
            submit.disabled = false;
          }
        },
        { signal },
      );
    }

    const invite = document.querySelector<HTMLButtonElement>(".friend-invite");
    const exchange =
      document.querySelector<HTMLDetailsElement>("#friend-exchange");
    const summary = exchange?.querySelector("summary");
    if (invite && exchange && summary) {
      invite.hidden = false;
      exchange.dataset.inviteReady = "";
      invite.setAttribute("aria-expanded", String(exchange.open));
      invite.addEventListener(
        "click",
        () => {
          exchange.open = !exchange.open;
          if (exchange.open) {
            summary.focus({ preventScroll: true });
            exchange.scrollIntoView({
              block: "start",
              behavior: matchMedia("(prefers-reduced-motion: reduce)").matches
                ? "instant"
                : "smooth",
            });
          }
        },
        { signal },
      );
      exchange.addEventListener(
        "toggle",
        () => invite.setAttribute("aria-expanded", String(exchange.open)),
        { signal },
      );
      summary.addEventListener(
        "click",
        () => {
          if (exchange.open) requestAnimationFrame(() => invite.focus());
        },
        { signal },
      );
    }

    if (!navigator.clipboard) return;
    const buttons = document.querySelectorAll<HTMLButtonElement>(
      "[data-copy-friend-exchange]",
    );
    for (const button of buttons) {
      const text = document
        .getElementById(button.dataset.copyFriendExchange ?? "")
        ?.textContent?.trimEnd();
      const status = button.parentElement?.querySelector('[role="status"]');
      if (!text || !status) continue;
      button.hidden = false;
      button.addEventListener(
        "click",
        async () => {
          try {
            await navigator.clipboard.writeText(text);
            status.textContent = "已复制";
          } catch {
            status.textContent = "请选中上方文字手动复制";
          }
        },
        { signal },
      );
    }
  });
</script>

<style>
  .friend-backdrop {
    --sky-haze: #182438;
    position: fixed;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(
        ellipse 74% 84% at 49% 45%,
        var(--sky-haze),
        transparent 88%
      ),
      var(--paper);
  }

  :global(:root[data-theme="light"]) .friend-backdrop {
    --sky-haze: #e3effc;
  }

  .friend-backdrop :global(.friend-galaxy) {
    position: absolute;
    inset: 0;
    opacity: 0.53;
    mask-image: linear-gradient(to bottom, #0008, #000 20%, #000 72%, #0003);
  }

  .friend-sky {
    --sky-ink: #edf2fb;
    --sky-muted: #abbcd2;
    --sky-thread: #90aacc;
    --sky-focus: #c6defe;
    --sky-avatar-core: #9bb7e985;
    --sky-avatar-halo: #9bb7e962;
    --sky-avatar-hover: #a9c3e5a0;
    position: relative;
    display: block;
    min-height: clamp(420px, 50vw, 535px);
    padding-block: 19px 30px;
    color: var(--sky-ink);
    touch-action: manipulation;
  }

  :global(:root[data-theme="light"]) .friend-sky {
    --sky-ink: #233a57;
    --sky-muted: #435c7c;
    --sky-thread: #456b98;
    --sky-focus: #355f96;
    --sky-avatar-core: #7295bd66;
    --sky-avatar-halo: #8faedb82;
    --sky-avatar-hover: #7e9fcaa3;
  }

  .friend-connections {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .friend-heading {
    text-align: center;
  }

  .friend-heading h1 {
    font-size: clamp(25px, 4.15vw, 43px);
    font-weight: 500;
    letter-spacing: 0.045em;
    line-height: 1.35;
    text-wrap: balance;
  }

  .friend-heading p {
    margin-top: 10px;
    color: var(--sky-muted);
    font-size: 13px;
  }

  .friend-connections :global(path) {
    fill: none;
    stroke: var(--sky-thread);
    stroke-opacity: 0.2;
    transition: stroke-opacity 250ms ease;
  }

  .friend-sky:has(.friend-star:is(:hover, :focus-visible))
    .friend-connections
    :global(path) {
    stroke-opacity: 0.45;
  }

  .friend-stars {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    align-items: start;
    justify-items: center;
    gap: 18px 0;
    margin: clamp(42px, 7vw, 72px) 0 0;
    padding: 0;
    list-style: none;
    pointer-events: none;
  }

  .friend-star-position {
    grid-column: span 4;
    min-width: 0;
    max-width: 100%;
  }

  .friend-star-position:first-child {
    grid-column: 2 / span 4;
    margin-top: clamp(54px, 8vw, 93px);
  }

  .friend-star-position:nth-child(2) {
    grid-column: 6 / span 3;
  }

  .friend-star-position:nth-child(3) {
    grid-column: 9 / span 3;
    margin-top: clamp(94px, 11vw, 132px);
  }

  .friend-stars > .friend-invite-position {
    display: flex;
    grid-column: 1 / -1;
    justify-self: stretch;
    justify-content: center;
    margin: 0;
    padding-inline-end: 10%;
  }

  .friend-invite:not([hidden]) {
    display: grid;
    justify-items: center;
    gap: 2px;
    min-width: 112px;
    padding: 4px 8px;
    border: 0;
    border-radius: 12px;
    background: transparent;
    color: var(--accent-dark);
    cursor: pointer;
    font-size: 13px;
    line-height: 1.5;
    pointer-events: auto;
  }

  .friend-invite small {
    color: var(--sky-muted);
    font-size: 11px;
  }

  .friend-invite-mark {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    margin-bottom: 5px;
    border: 1px dashed color-mix(in srgb, var(--accent) 74%, transparent);
    border-radius: 50%;
    background: color-mix(in srgb, var(--paper) 80%, transparent);
    box-shadow: 0 0 16px color-mix(in srgb, var(--accent) 15%, transparent);
    transition:
      box-shadow 220ms ease,
      background-color 220ms ease;
  }

  .friend-invite:is(:hover, :focus-visible, [aria-expanded="true"])
    .friend-invite-mark {
    border-color: var(--accent);
    border-style: solid;
    background-color: var(--soft);
    box-shadow: 0 0 24px color-mix(in srgb, var(--accent) 38%, transparent);
  }

  .friend-star {
    --portrait: clamp(28px, 4.5vw, 40px);
    display: flex;
    min-width: 48px;
    min-height: 44px;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding-inline: 4px;
    color: var(--sky-muted);
    font-size: 12px;
    text-align: center;
    overflow-wrap: anywhere;
    pointer-events: auto;
  }

  .friend-stars li:first-child .friend-star {
    --portrait: clamp(30px, 4.85vw, 43px);
  }

  .friend-star small {
    display: block;
    margin-top: 4px;
    font-size: 11px;
  }

  .friend-star img {
    display: block;
    width: var(--portrait);
    height: var(--portrait);
    border-radius: 50%;
    object-fit: cover;
    box-shadow:
      0 0 8px var(--sky-avatar-core),
      0 0 24px var(--sky-avatar-halo);
    transition:
      transform 250ms ease,
      box-shadow 250ms ease;
  }

  .friend-star:is(:hover, :focus-visible) {
    color: var(--sky-ink);
  }

  .friend-star:is(:hover, :focus-visible) img {
    transform: scale(1.1);
    box-shadow: 0 0 30px var(--sky-avatar-hover);
  }

  .friend-star:focus-visible {
    outline-color: var(--sky-focus);
  }

  .friend-exchange {
    padding-block: 18px 12px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 13px;
  }

  .friend-exchange[data-invite-ready]:not([open]) {
    display: none;
  }

  .friend-exchange summary {
    width: fit-content;
    min-height: 44px;
    line-height: 44px;
    color: var(--ink);
    cursor: pointer;
    font-size: clamp(17px, 2vw, 22px);
    font-weight: 500;
  }

  .friend-exchange p {
    margin-block: 3px 7px;
  }

  .friend-exchange-steps {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px 24px;
    margin: 16px 0 10px;
    padding: 0;
    list-style: none;
  }

  .friend-exchange-steps h2 {
    margin-bottom: 8px;
    color: var(--ink);
    font-size: 14px;
    font-weight: 500;
  }

  .friend-exchange pre {
    margin: 0;
    padding: 12px 14px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: color-mix(in srgb, var(--paper) 65%, transparent);
    color: var(--ink);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .friend-exchange-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 5px 16px;
    margin-top: 8px;
  }

  .friend-exchange-actions button {
    line-height: 44px;
    color: var(--accent-dark);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .friend-exchange-actions button {
    appearance: none;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  .friend-application {
    display: grid;
    gap: 10px;
  }

  .friend-application label {
    display: grid;
    gap: 3px;
  }

  .friend-application input,
  .friend-application textarea {
    width: 100%;
    min-width: 0;
    padding: 8px 10px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: color-mix(in srgb, var(--paper) 72%, transparent);
    color: var(--ink);
    font: inherit;
  }

  .friend-application button {
    justify-self: start;
    min-height: 44px;
    padding-inline: 14px;
    border: 1px solid color-mix(in srgb, var(--accent) 34%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--paper) 86%, var(--accent));
    color: var(--accent-dark);
    cursor: pointer;
  }

  .friend-application button:disabled {
    opacity: 0.6;
    cursor: default;
  }

  @media (max-width: 650px) {
    .friend-stars > .friend-invite-position {
      padding-inline-end: 34%;
    }

    .friend-exchange-steps {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .friend-invite-mark,
    .friend-connections :global(path),
    .friend-star img {
      transition: none;
    }

    .friend-star:is(:hover, :focus-visible) img {
      transform: none;
    }
  }
</style>
